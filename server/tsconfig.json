{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "useDefineForClassFields": false,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "../shared/**/*", "../src/constants.ts"],
  "ts-node": {
    "transpileOnly": true
  }
}
